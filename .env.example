# JWT Security Secret (Minimum 256 bits / 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Server Port
SERVER_PORT=8080

# Frontend API URL
VITE_API_URL=http://localhost:8080/api
